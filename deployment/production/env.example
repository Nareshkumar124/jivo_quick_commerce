# Production env NAMES only. No values here, ever (the repository is public).
# Real files live only on the server: /srv/jqc-prod/env/{backend,postgres,minio}.env (mode 600),
# generated there with Python's `secrets` module, never printed, never copied from staging.

# ---- /srv/jqc-prod/env/backend.env ----
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=                 # generated on the server
JWT_SIGNING_KEY=                   # generated, different from DJANGO_SECRET_KEY
OTP_HASH_KEY=                      # generated, different from both above
FIELD_ENCRYPTION_KEYS=             # generated Fernet key; backup in env/keys-backup/ (+ offline copy)
DJANGO_ALLOWED_HOSTS=              # production domain (P1); placeholder until known
DJANGO_CSRF_TRUSTED_ORIGINS=       # https://<production domain>
NUM_PROXIES=1
LOG_LEVEL=INFO
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=                 # generated, same value as postgres.env
POSTGRES_SSLMODE=disable
POSTGRES_POOL_MAX_SIZE=8
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CHANNELS_REDIS_URL=redis://redis:6379/2
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=                  # = MINIO_ROOT_USER
S3_SECRET_ACCESS_KEY=              # = MINIO_ROOT_PASSWORD
S3_REGION=ap-south-1
S3_MEDIA_BUCKET=jivo-media
S3_PUBLIC_MEDIA_BUCKET=jivo-public
S3_PUBLIC_MEDIA_DOMAIN=            # <production domain>/media
S3_PUBLIC_MEDIA_PROTOCOL=https:
S3_PRESIGN_ENDPOINT_URL=           # https://<production domain>
EMAIL_BACKEND=                     # dummy until an SMTP service is chosen
DEFAULT_FROM_EMAIL=
COD_UPI_QR_ENABLED=false
PAYMENT_GATEWAY=apps.payments.gateways.RazorpayGateway
ONLINE_PAYMENTS_ENABLED=false       # cash on delivery only until the LIVE Razorpay keys arrive (DL-85)
RAZORPAY_KEY_ID=                   # LIVE key (P3), not yet set
RAZORPAY_KEY_SECRET=               # LIVE secret (P3), not yet set
RAZORPAY_WEBHOOK_SECRET=           # LIVE webhook secret (P3), not yet set
# SMS_BACKEND / MSG91_* / SMS_*:   unset = UnconfiguredSmsBackend (sends fail loudly) until P4
STORE_REVIEW_LOGINS=               # store-reviewer phone:code list (D-15); empty = off
# FCM_CREDENTIALS_FILE=/run/secrets/fcm-service-account.json   only with the prod key file (P5)
# GOOGLE_MAPS_SERVER_KEY=          (P6)
# SENTRY_DSN= / SENTRY_ENVIRONMENT=production / SENTRY_RELEASE=   (P11)
# Never set in production (settings refuse to start): SEED_DEMO_ALLOWED, OTP_TEST_NUMBERS,
# LOADTEST_DATA_ALLOWED, SMS_CONSOLE_BACKEND_ALLOWED, FAKE_GATEWAY_DOWN, JQC_SKIP_STARTUP_CHECK.

# ---- /srv/jqc-prod/env/postgres.env ----
POSTGRES_USER=
POSTGRES_PASSWORD=                 # generated
POSTGRES_DB=

# ---- /srv/jqc-prod/env/minio.env ----
MINIO_ROOT_USER=                   # generated
MINIO_ROOT_PASSWORD=               # generated

# ---- /srv/jqc-prod/compose/.env (interpolation, not secrets) ----
JQCPROD_HOST=                      # production domain (placeholder until P1)
# JQCPROD_FCM_KEY_FILE=            # host path of the prod FCM key file (P5)
