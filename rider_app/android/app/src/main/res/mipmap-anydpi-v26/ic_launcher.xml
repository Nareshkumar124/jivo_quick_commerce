<?xml version="1.0" encoding="utf-8"?>
<!-- Jivo Rider launcher icon (official Jivo logo, 2026-11-23): white Jivo
     face plus a small "RIDER" pill on the brand green. minSdk is 26, so every
     device uses this; mipmap-*/ic_launcher.png are the legacy fallback. All
     PNGs come from rider_app/tool/gen_brand_assets.py. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
