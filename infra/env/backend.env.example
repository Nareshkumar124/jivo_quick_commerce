# Backend settings. Copy to backend/.env for local development (gitignored) and fill in values.
# Placeholders only: never commit real secrets. Every variable read by config/settings/*.py is
# listed here (CI: infra/scripts/check_env_example.py fails on a missing name).
# Values shown are the local defaults unless marked REQUIRED.

# --- Django -------------------------------------------------------------------------------------
# local | test | staging | production  (manage.py and celery default to local; asgi/wsgi to production)
DJANGO_SETTINGS_MODULE=config.settings.local
# REQUIRED in staging/production (>= 50 chars). Local falls back to an insecure dev key.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# REQUIRED in staging/production. Local default: localhost,127.0.0.1,[::1],10.0.2.2,backend
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SESSION_COOKIE_AGE=43200
# Staff sessions (05 §5, BUG-0006): absolute limit after login, and the idle limit for admin roles
DJANGO_STAFF_SESSION_MAX_AGE_SECONDS=28800
DJANGO_STAFF_SESSION_IDLE_SECONDS=7200
# Production/staging only (defaults shown)
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
LOG_LEVEL=INFO

# --- PostgreSQL (REQUIRED) -----------------------------------------------------------------------
# Separate variables on purpose: no DATABASE_URL (passwords may contain URL-reserved characters).
# Phase 0-1: plain PostgreSQL 16. Phase 2 needs the PostGIS extension on this server.
POSTGRES_HOST=<postgres-host>
POSTGRES_PORT=5432
POSTGRES_DB=jivo_quick_commerce
POSTGRES_USER=<postgres-user>
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_CONN_MAX_AGE=0
# Fail fast on a dropped connection to the remote DB (seconds / milliseconds)
POSTGRES_KEEPALIVES_IDLE=30
POSTGRES_TCP_USER_TIMEOUT_MS=60000
# Connection pool (T-218). Web (ASGI) processes: POSTGRES_POOL=true and POSTGRES_CONN_MAX_AGE=0.
# Celery worker / beat: POSTGRES_POOL=false and POSTGRES_CONN_MAX_AGE=60. Never both (Django refuses
# a pool with CONN_MAX_AGE > 0). Budget: web processes x POSTGRES_POOL_MAX_SIZE + Celery concurrency
# must stay under the DB server's connection limit (the server is shared). Timeouts in seconds.
POSTGRES_POOL=false
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=8
POSTGRES_POOL_TIMEOUT=10
POSTGRES_POOL_MAX_IDLE=300
POSTGRES_POOL_MAX_LIFETIME=1800
# pytest only: the database pytest creates/drops. Must start with `test_jivo_quick_commerce`
# (refused otherwise). Parallel runs use separate names, e.g. test_jivo_quick_commerce_admin.
POSTGRES_TEST_DB=test_jivo_quick_commerce

# --- GeoDjango native libraries (optional) ------------------------------------------------------
# Leave empty on Linux and in the Docker image (Django finds libgdal/libgeos_c itself). Windows hosts
# set full paths to the versioned DLLs, e.g. C:/path/to/gdal.dll and C:/path/to/geos_c.dll.
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=

# --- Redis (compose service, host port 6380) -----------------------------------------------------
# In compose containers the host is `redis` instead of `localhost` (set in docker-compose.yml).
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CHANNELS_REDIS_URL=redis://localhost:6380/2
# pytest only: a dedicated DB that tests may clear. TEST_REDIS_DB (3-15) overrides the DB index of
# REDIS_TEST_URL, so parallel test runs (e.g. two agents) do not share cache/rate-limit state.
REDIS_TEST_URL=redis://localhost:6380/15
TEST_REDIS_DB=15

# --- Object storage (MinIO locally on 9000/9001, S3 in the cloud) --------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=jivo-local
S3_SECRET_ACCESS_KEY=<minio-or-s3-secret>
S3_REGION=ap-south-1
S3_MEDIA_BUCKET=jivo-media
# Public catalog media (product/category/banner images): plain non-expiring URLs.
# seed_demo creates this bucket with a public-read policy on local MinIO.
S3_PUBLIC_MEDIA_BUCKET=jivo-public
# CDN host in the cloud, e.g. media.jivo.in. For a phone/emulator against local MinIO use
# 10.0.2.2:9000/jivo-public (emulator) or <LAN-IP>:9000/jivo-public with protocol http:.
S3_PUBLIC_MEDIA_DOMAIN=
S3_PUBLIC_MEDIA_PROTOCOL=https:

# --- Email (Mailpit locally: SMTP 1025, UI http://localhost:8025) --------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Jivo Quick Commerce <noreply@localhost>

# --- API ----------------------------------------------------------------------------------------
# /api/schema/ and /api/docs/ without login. Local default true; forced false in production.
API_DOCS_PUBLIC=true
# Production/staging: separate JWT signing key (defaults to DJANGO_SECRET_KEY)
JWT_SIGNING_KEY=

# --- Reverse proxies / client IP ---------------------------------------------------------------
# Number of trusted proxies (nginx, load balancer) in front of Django; client IPs for OTP limits,
# DRF throttles and the staff lockout come from X-Forwarded-For when > 0. Local: 0.
# REQUIRED in staging/production (usually 1 behind nginx or a load balancer).
NUM_PROXIES=0

# --- Phone OTP (09 §3.1) ------------------------------------------------------------------------
OTP_SEND_LIMIT_PER_10_MIN=3
OTP_SEND_LIMIT_PER_DAY=10
OTP_SEND_LIMIT_PER_IP_PER_HOUR=30
OTP_VERIFY_LIMIT_PER_IP_PER_HOUR=60
# D-15 fixed-OTP test numbers "phone:code,phone:code" (no SMS, no send limits). Local defaults to
# +919000000001..3 with 123456. Allowed on staging; production refuses to start if set.
OTP_TEST_NUMBERS=

# --- SMS (D-02) ---------------------------------------------------------------------------------
# apps.notifications.sms.ConsoleSmsBackend logs messages (local); TwilioSmsBackend sends via Twilio.
# Staging/production default: apps.notifications.sms.UnconfiguredSmsBackend (sends fail loudly).
SMS_BACKEND=apps.notifications.sms.ConsoleSmsBackend
# Staging/production only: allow the console/locmem backend (logs OTP codes). Never in production.
SMS_CONSOLE_BACKEND_ALLOWED=false
SMS_SENDER_ID=
SMS_OTP_DLT_TEMPLATE_ID=
# Must match the DLT-registered text. Placeholders: {otp}, {app_hash}.
SMS_OTP_TEMPLATE=<#> {otp} is your Jivo verification code. It expires in 5 minutes. Do not share it with anyone. {app_hash}
# Android SMS Retriever hashes (11 chars) for OTP autofill
SMS_APP_HASH_CUSTOMER=
SMS_APP_HASH_RIDER=
# Twilio (D-02, opt-in): set SMS_BACKEND=apps.notifications.sms.TwilioSmsBackend and fill these.
# Twilio Console > Account info: Account SID + Auth token (secret). Sender: a Messaging Service SID
# (MG..., preferred, used when set) or a Twilio number in E.164 (+1...). System check accounts.E004
# refuses Twilio without SID, token and one sender. India: production sends need a DLT-registered
# sender and template on the Twilio account; a trial account only sends to verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# --- Accounts -----------------------------------------------------------------------------------
# Deleted accounts are anonymised after this many days (07 §4)
ACCOUNT_DELETION_GRACE_DAYS=30
# Staff login lockout (django-axes): failures per username+IP, and the cool-off
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# --- Project flags -------------------------------------------------------------------------------
# manage.py seed_demo is refused when false (production default false, staging true)
SEED_DEMO_ALLOWED=true
# Password for the seed_demo staff users (the only source; never committed). Unset: new staff get
# unusable passwords. Apply to existing staff with `manage.py seed_demo --reset-staff-passwords`.
SEED_DEMO_STAFF_PASSWORD=

# --- Sentry (D-19); disabled when SENTRY_DSN is empty ---------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Policy (docs/deployment.md §10.1): staging 0.2, production 0.05; errors are always sent.
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Production image only (backend/Dockerfile; read by the image, not by Django) -----------------
# Largest WebSocket message uvicorn accepts, in bytes (P8 L5; default 65536).
WS_MAX_MESSAGE_BYTES=65536
# 1 skips the entrypoint's `check --deploy` for ONE one-off command; never set on a service (M8).
JQC_SKIP_STARTUP_CHECK=0

# --- docker-compose only (infra/docker-compose.yml interpolation; local placeholders) -----------
MINIO_ROOT_USER=jivo-local
MINIO_ROOT_PASSWORD=<minio-root-password>

# --- Stores & catalog (Phase 2) ------------------------------------------------------------------
# "Only N left" (LOW_STOCK) threshold, DL-26
CATALOG_LOW_STOCK_UNITS=3
# Per-store Redis cache of home/catalog responses (seconds)
CATALOG_CACHE_SECONDS=300
# ETA (08 §8): prep + rider wait + distance x road factor / speed + buffer
ETA_AVG_SPEED_KMPH=20
ETA_ROAD_FACTOR=1.3
ETA_BUFFER_MINUTES=2
ETA_RIDER_WAIT_MINUTES=3
# Notify-me leads per user (or IP when anonymous); DRF rate syntax
NOTIFY_ME_RATE=10/hour

# --- Cart, orders & payments (Phase 3) -----------------------------------------------------------
# Largest rider tip the cart accepts, in rupees (2-decimal string)
CART_MAX_TIP=500.00
# Per-user DRF throttles for POST /orders/ and the payment endpoints (fail open if Redis is down)
ORDERS_CREATE_RATE=30/hour
PAYMENTS_RATE=60/hour
# Gateway class (D-01, DL-21). The real gateway is the only value for staging/production.
# Local/dev may set apps.payments.gateways.FakeRazorpayGateway (no keys, no money; also the local
# and test settings default); deployed settings refuse the fake (system check payments.E001).
PAYMENT_GATEWAY=apps.payments.gateways.RazorpayGateway
# Razorpay Dashboard > Account & Settings > API keys. Test keys (rzp_test_...) on staging, live keys
# in production only. REQUIRED wherever PAYMENT_GATEWAY is RazorpayGateway. Secrets: never commit.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret typed into Razorpay Dashboard > Webhooks for /api/v1/payments/razorpay/webhook/
# (docs/deployment.md "Razorpay webhook"). A different value per environment.
RAZORPAY_WEBHOOK_SECRET=
# Seconds to wait for one Razorpay API call (create order, list payments, refund)
RAZORPAY_TIMEOUT_SECONDS=10
# A refund.* webhook for a refund not recorded yet answers 503 (Razorpay retries) only while a
# PENDING refund of that payment is younger than this; process_refund retries for at most ~95 min
REFUND_WEBHOOK_RETRY_WINDOW_SECONDS=7200

# --- Order processing (Phase 4) ------------------------------------------------------------------
# Local development only: the fake payment gateway answers as if Razorpay were down (P3-TC-63).
# Refused in staging/production (payments.E004).
FAKE_GATEWAY_DOWN=False
# 08 §7: last state in which the customer may cancel in the app (PLACED or ACCEPTED)
CUSTOMER_CANCEL_UNTIL=ACCEPTED
# Ops alert when a store has not accepted an order within this (seconds)
STORE_ACCEPTANCE_SLA_SECONDS=60
# Auto-accept stores: accept this long after PLACED (seconds)
AUTO_ACCEPT_DELAY_SECONDS=0
# 08 §2.1: ACCEPTED (default) or PLACED
DISPATCH_TRIGGER=ACCEPTED
# 08 §6.4 (D-10 default): keep the delivery fee when a delivery fails through the customer's fault
REFUND_KEEP_DELIVERY_FEE_ON_CUSTOMER_FAULT=True
# 05 §3: Support refunds at most this per refund (rupees)
SUPPORT_REFUND_LIMIT=500.00
# A PENDING refund with no gateway answer after this is sent again (minutes)
REFUND_STUCK_MINUTES=10
# Invoices (D-12 pending): placeholder seller name, fee SAC and fee GST rate
INVOICE_SELLER_NAME=Jivo Wellness (placeholder)
INVOICE_FEE_SAC=SAC-TBD
INVOICE_FEE_GST_RATE=18.00
# Signed invoice links expire after this (seconds)
INVOICE_URL_EXPIRY_SECONDS=600

# Support tickets (P7): per-user limits (DRF rate strings; fail open when Redis is down)
SUPPORT_TICKETS_CREATE_RATE=10/hour
SUPPORT_MESSAGES_RATE=60/hour
