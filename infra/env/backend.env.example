# Backend settings. Copy to backend/.env for local development (gitignored) and fill in values.
# Placeholders only: never commit real secrets. Every variable read by config/settings/*.py is
# listed here. Values shown are the local defaults unless marked REQUIRED.

# --- Django -------------------------------------------------------------------------------------
# local | test | staging | production  (manage.py and celery default to local; asgi/wsgi to production)
DJANGO_SETTINGS_MODULE=config.settings.local
# REQUIRED in staging/production (>= 50 chars). Local falls back to an insecure dev key.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# REQUIRED in staging/production. Local default: localhost,127.0.0.1,[::1],10.0.2.2,backend
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SESSION_COOKIE_AGE=43200
# Production/staging only (defaults shown)
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
LOG_LEVEL=INFO

# --- PostgreSQL (REQUIRED) -----------------------------------------------------------------------
# Separate variables on purpose: no DATABASE_URL (passwords may contain URL-reserved characters).
# Phase 0-1: plain PostgreSQL 16. Phase 2 needs the PostGIS extension on this server.
POSTGRES_HOST=<postgres-host>
POSTGRES_PORT=5432
POSTGRES_DB=jivo_quick_commerce
POSTGRES_USER=<postgres-user>
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_CONN_MAX_AGE=0

# --- Redis (compose service, host port 6380) -----------------------------------------------------
# In compose containers the host is `redis` instead of `localhost` (set in docker-compose.yml).
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CHANNELS_REDIS_URL=redis://localhost:6380/2
# pytest only: a dedicated DB that tests may clear
REDIS_TEST_URL=redis://localhost:6380/15

# --- Object storage (MinIO locally on 9000/9001, S3 in the cloud) --------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=jivo-local
S3_SECRET_ACCESS_KEY=<minio-or-s3-secret>
S3_REGION=ap-south-1
S3_MEDIA_BUCKET=jivo-media

# --- Email (Mailpit locally: SMTP 1025, UI http://localhost:8025) --------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Jivo Quick Commerce <noreply@localhost>

# --- API ----------------------------------------------------------------------------------------
# /api/schema/ and /api/docs/ without login. Local default true; forced false in production.
API_DOCS_PUBLIC=true
# Production/staging: separate JWT signing key (defaults to DJANGO_SECRET_KEY)
JWT_SIGNING_KEY=

# --- Reverse proxies / client IP ---------------------------------------------------------------
# Number of trusted proxies (nginx, load balancer) in front of Django; client IPs for OTP limits,
# DRF throttles and the staff lockout come from X-Forwarded-For when > 0. Local: 0.
# REQUIRED in staging/production (usually 1 behind nginx or a load balancer).
NUM_PROXIES=0

# --- Phone OTP (09 §3.1) ------------------------------------------------------------------------
OTP_SEND_LIMIT_PER_10_MIN=3
OTP_SEND_LIMIT_PER_DAY=10
OTP_SEND_LIMIT_PER_IP_PER_HOUR=30
OTP_VERIFY_LIMIT_PER_IP_PER_HOUR=60
# D-15 fixed-OTP test numbers "phone:code,phone:code" (no SMS, no send limits). Local defaults to
# +919000000001..3 with 123456. Allowed on staging; production refuses to start if set.
OTP_TEST_NUMBERS=

# --- SMS (D-02) ---------------------------------------------------------------------------------
# apps.notifications.sms.ConsoleSmsBackend logs messages (local). A gateway backend comes with D-02.
SMS_BACKEND=apps.notifications.sms.ConsoleSmsBackend
SMS_SENDER_ID=
SMS_OTP_DLT_TEMPLATE_ID=
# Must match the DLT-registered text. Placeholders: {otp}, {app_hash}.
SMS_OTP_TEMPLATE=<#> {otp} is your Jivo verification code. It expires in 5 minutes. Do not share it with anyone. {app_hash}
# Android SMS Retriever hashes (11 chars) for OTP autofill
SMS_APP_HASH_CUSTOMER=
SMS_APP_HASH_RIDER=

# --- Accounts -----------------------------------------------------------------------------------
# Deleted accounts are anonymised after this many days (07 §4)
ACCOUNT_DELETION_GRACE_DAYS=30
# Staff login lockout (django-axes): failures per username+IP, and the cool-off
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# --- Project flags -------------------------------------------------------------------------------
# manage.py seed_demo is refused when false (production default false, staging true)
SEED_DEMO_ALLOWED=true
# Password for the seed_demo staff users (the only source; never committed). Unset: new staff get
# unusable passwords. Apply to existing staff with `manage.py seed_demo --reset-staff-passwords`.
SEED_DEMO_STAFF_PASSWORD=

# --- Sentry (D-19); disabled when SENTRY_DSN is empty ---------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- docker-compose only (infra/docker-compose.yml interpolation; local placeholders) -----------
MINIO_ROOT_USER=jivo-local
MINIO_ROOT_PASSWORD=<minio-root-password>
