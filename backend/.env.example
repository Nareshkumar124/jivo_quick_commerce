# Phase 3 backend settings (cart, orders and payments). Placeholders only: never commit real values.
# Copy the lines you need into backend/.env (gitignored). The full list of backend variables is
# infra/env/backend.env.example; these Phase 3 lines need to be mirrored there by devops.

# --- Cart -----------------------------------------------------------------------------------------
# Largest rider tip a cart accepts, in rupees (PM default 500.00, pending confirmation).
CART_MAX_TIP=500.00

# --- Order and payment rate limits (per user, fail open when Redis is down) -------------------------
ORDERS_CREATE_RATE=30/hour
# Payment verify and retry-payment
PAYMENTS_RATE=60/hour

# --- Payments (D-01, DL-21) -----------------------------------------------------------------------
# Gateway class. Default: apps.payments.gateways.RazorpayGateway (staging/production).
# local and test default to apps.payments.gateways.FakeRazorpayGateway (no keys, no money; the
# dev-only scheme is in docs/06-backend-modules-and-api.md §2.6). Staging and production refuse
# the fake gateway (system check payments.E001). Leave it unset unless you want Razorpay test mode
# locally (then also set the three keys below).
# PAYMENT_GATEWAY=apps.payments.gateways.RazorpayGateway
# Razorpay Dashboard > Account & Settings > API keys. Test keys on staging, live keys in
# production. REQUIRED wherever RazorpayGateway is used; payments fail loudly without them.
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
# Razorpay Dashboard > Webhooks: the secret set on the webhook for
# https://<api-host>/api/v1/payments/razorpay/webhook/ (payment.captured, payment.failed,
# refund.processed, refund.failed).
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>
